#!/bin/sh
# Legacy CI inject — BBR/UPnP/lang now handled by default-settings-vn.
# Keep UPnP enable here for builds that skip default-settings-vn.

if uci -q get upnpd.config > /dev/null; then
	uci -q set upnpd.config.enabled='1'
	uci -q commit upnpd
fi

# Đổi IP LAN sang 192.168.68.1
uci -q set network.lan.ipaddr='192.168.68.1'
uci -q commit network

exit 0
